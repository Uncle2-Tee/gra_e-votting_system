DATABASE_URL=postgresql://USER:PASSWORD@db.example.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@db.example.com:5432/postgres
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
VOTER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
VOTER_LOOKUP_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY
VOTER_IMPORT_ENABLED=false
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
APP_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
BALLOTING_ENABLED=true
